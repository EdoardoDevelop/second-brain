# Password per accedere all'app (singolo utente)
APP_PASSWORD=cambiami
# Segreto per firmare il cookie di sessione (stringa lunga e casuale)
SESSION_SECRET=sostituisci-con-una-stringa-lunga-e-casuale

# Database: un file SQLite (in produzione sul VPS è data/second-brain.db)
DATABASE_URL=file:data/second-brain.db
# Solo per un database remoto (Turso):
# DATABASE_AUTH_TOKEN=

# OpenRouter (senza chiave l'app funziona, ma senza IA). Si può impostare anche dall'app.
OPENROUTER_API_KEY=
# Modello veloce predefinito; gli altri modelli, la privacy e il tetto di spesa si scelgono in Impostazioni → IA
# AI_MODEL=google/gemini-3.5-flash-lite
# AI_DATA_COLLECTION=allow

# Facoltativi
# FILES_DIR=data/files
# PUSH_CONTACT=mailto:tu@esempio.it
